<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pekey – nastavení"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Slovníky"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusDicts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Žádný slovník není naimportovaný"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnImportDict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Importovat slovník (.dict)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Gestová knihovna"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusLib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Knihovna není naimportovaná"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnImportLib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Importovat knihovnu (.so)" />
    </LinearLayout>
</ScrollView>